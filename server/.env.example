# Credenciais do LiveKit (LiveKit Cloud ou self-hosted).
# NUNCA coloque estes valores no frontend nem faça commit do .env real.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud

# Porta do servidor de tokens (Render define PORT automaticamente).
PORT=3001

# Origem(ns) permitida(s) para CORS, separadas por vírgula.
# Em desenvolvimento pode deixar em branco (libera tudo).
# Em produção, use o domínio real do frontend:
# CORS_ORIGIN=https://concord.onrender.com
CORS_ORIGIN=
